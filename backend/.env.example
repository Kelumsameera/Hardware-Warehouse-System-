NODE_ENV=development
PORT=4000
# Transactions (stock movements, reservations) need a replica set. See README "MongoDB replica set".
MONGODB_URI=mongodb://127.0.0.1:27017/engineering_wms?replicaSet=rs0
# Comma-separated list of browser origins allowed by CORS
CLIENT_ORIGIN=http://localhost:3000
# Long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# One-time token for POST /api/auth/bootstrap (creates the first Super Admin when no users exist)
INITIAL_ADMIN_SETUP_TOKEN=change-me
# Optional: separate database for npm run test:integration (name must end with _test)
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/engineering_wms_test?replicaSet=rs0
